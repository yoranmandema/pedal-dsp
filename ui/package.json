{
  "name": "pedal-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pedal UI: Preact + TypeScript, shared by the Tauri shell and the plugin",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_ENGINE_URL=ws://127.0.0.1:9400 vite --port 5273 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test src/graph/scale.test.ts src/graph/eq.test.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test \"pnpm dev:e2e\" http://localhost:5273 \"pnpm cypress:run\""
  },
  "dependencies": {
    "@preact/signals": "^2.0.3",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "cypress": "16.3.0",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "ws": "^8.23.0"
  }
}
